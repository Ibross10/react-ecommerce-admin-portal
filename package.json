    "@testing-library/user-event": "^14.6.1",
    "@vitejs/plugin-react": "^4.4.1",
    "concurrently": "^9.1.2",
    "jsdom": "^26.1.0",
    "json-server": "^0.17.4",
    "vite": "^6.3.5",
    "vitest": "^3.2.4"
  }
}